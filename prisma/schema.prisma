// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

generator docs {
  provider = "node node_modules/prisma-docs-generator"
  output   = "../docs/database"
}

// ===================================
// ENUMS
// ===================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  USER
  GUEST
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_AUTH
  PHONE_VERIFICATION
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
  SYSTEM_ALERT // Admin system notifications
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ===================================
// Seiyon Car Rental PLATFORM ENUMS (Phase 1)
// ===================================

// VENDOR ENUMS
enum VendorStatus {
  PENDING      // Just registered, awaiting admin review
  VERIFIED     // Admin approved
  SUSPENDED    // Temporarily disabled
  REJECTED     // Admin rejected
}

// VEHICLE ENUMS
enum VehicleStatus {
  DRAFT           // Vendor saved but not submitted
  PENDING_REVIEW  // Submitted, waiting admin review
  APPROVED        // Approved and live on platform
  REJECTED        // Admin rejected (vendor can fix and resubmit)
  UNLISTED        // Vendor requested unlist and admin approved
  SUSPENDED       // Admin suspended the listing
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum VehicleCategory {
  SEDAN
  SUV
  HATCHBACK
  LUXURY
  SPORTS
  OFF_ROAD
  VAN
  TRUCK
  CONVERTIBLE
}

enum DocumentType {
  REGISTRATION
  OWNERSHIP_PROOF
  INSPECTION_CERTIFICATE
  INSURANCE_POLICY
  OTHER
}

enum UnlistRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// BOOKING ENUMS
enum BookingStatus {
  PENDING      // Created but payment not done
  CONFIRMED    // Payment successful
  ACTIVE       // Rental in progress
  COMPLETED    // Rental ended
  CANCELLED    // Cancelled by customer or vendor
  NO_SHOW      // Customer didn't show up
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BookingType {
  DAILY
  MONTHLY_SUBSCRIPTION
}

// SUBSCRIPTION ENUMS
enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum SubscriptionInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

// NOTIFICATION ENUMS
enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ===================================
// PHASE 2 ENUMS
// ===================================

enum CommentStatus {
  ACTIVE
  DELETED
  HIDDEN
}

enum ShareType {
  IN_APP
  EXTERNAL
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportedContentType {
  POST
  COMMENT
  USER
}

enum FeedbackType {
  BUG
  FEATURE
  GENERAL
  COMPLAINT
}

// ===================================
// CORE MODELS
// ===================================

// table for users
model User {
  // Primary Key
  id String @id @default(uuid())

  // Authentication fields
  email           String    @unique
  emailVerified   Boolean   @default(false)
  password        String
  passwordResetAt DateTime?

  // Profile information
  firstName     String?
  lastName      String?
  fullName      String?
  username      String?   @unique
  avatar        String? // URL to profile picture
  bio           String?   @db.Text
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  age           Int? // User's age
  gender        Gender? // User's gender
  dateOfBirth   DateTime? // Date of birth (alternative to age)

  // SSO fields
  provider   String? // e.g., 'google', 'linkedin', 'apple'
  providerId String? @unique // Unique SSO provider user id

  // Address information
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  timezone   String? @default("UTC")

  // App-specific fields
  language          String @default("en") // User's preferred language (en, es, fr, etc.)
  preferredCurrency String @default("USD") // User's preferred currency (USD, EUR, GBP, etc.)

  // Push Notification fields
  fcmTokens            String[] @default([]) // Array of FCM device tokens (supports multiple devices)
  notificationsEnabled Boolean  @default(true) // Master switch for all notifications
  pushEnabled          Boolean  @default(true) // Push notifications enabled
  emailNotifEnabled    Boolean  @default(true) // Email notifications enabled
  smsNotifEnabled      Boolean  @default(false) // SMS notifications enabled

  // System fields
  status             UserStatus @default(INACTIVE)
  role               UserRole   @default(USER)
  isEmailVerified    Boolean    @default(false)
  isTwoFactorEnabled Boolean    @default(false)

  // Metadata
  metadata    Json? // Flexible field for additional data
  preferences Json? // User preferences
  settings    Json? // User settings

  // Activity tracking
  lastLoginAt  DateTime?
  lastActiveAt DateTime?
  loginCount   Int       @default(0)

  // Audit fields (Common pattern for all models)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false) // Soft delete
  deletedAt DateTime?
  deletedBy String?

  // Relations
  sessions                Session[]
  otpVerifications        OtpVerification[]
  auditLogs               AuditLog[]              @relation("UserAuditLogs")
  supportTickets          SupportTicket[]         @relation("UserTickets")
  assignedTickets         SupportTicket[]         @relation("AssignedTickets")
  vendorProfile           VendorProfile?
  bookings                Booking[]               @relation("CustomerBookings")
  notifications           Notification[]
  reviews                 Review[]
  subscriptions           UserSubscription[]


  // Indexes
  @@index([email])
  @@index([username])
  @@index([phone])
  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([isDeleted])
  @@map("users")
}

// table for user sessions
model Session {
  // Primary Key
  id String @id @default(uuid())

  // Session identification
  token        String  @unique
  refreshToken String? @unique
  sessionId    String? @unique // Additional session identifier

  // User relationship
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session metadata
  deviceInfo String? // Information about the device
  ipAddress  String? // IP address
  userAgent  String? // User agent string
  location   String? // Geographic location
  platform   String? // Platform (web, mobile, desktop)

  // Status and lifecycle
  status        SessionStatus @default(ACTIVE)
  isActive      Boolean       @default(true)
  lastUsedAt    DateTime      @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  // Security
  fingerprint String? // Browser/device fingerprint

  // Audit fields (Common pattern for all models)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false) // Soft delete
  deletedAt DateTime?
  deletedBy String?

  // Indexes
  @@index([userId])
  @@index([token])
  @@index([refreshToken])
  @@index([status])
  @@index([expiresAt])
  @@index([isActive])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("sessions")
}

model OtpVerification {
  id             String    @id @default(uuid())
  email          String    @unique
  otp            String
  type           OtpType
  expiresAt      DateTime
  verified       Boolean   @default(false)
  attemptCount   Int       @default(0)
  otpCooldown    DateTime? // When the user can request a new OTP
  otpLockedUntil DateTime? // If locked out, when they can try again
  userId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type]) // Index for faster lookups
  @@index([userId]) // Index for faster lookups by user
  @@map("otp_verifications")
}

// ===================================
// AUDIT & LOGGING MODELS
// ===================================

model AuditLog {
  // Primary Key
  id String @id @default(uuid())

  // Actor information
  userId    String?
  user      User?   @relation("UserAuditLogs", fields: [userId], references: [id])
  actorType String? // USER, SYSTEM, API, etc.
  actorId   String? // ID of the actor (user, system, etc.)

  // Action details
  action      AuditAction
  resource    String // Table/resource name
  resourceId  String? // ID of the affected resource
  description String? // Human-readable description

  // Change tracking
  oldValues Json? // Previous values
  newValues Json? // New values
  changes   Json? // Specific changes made

  // Context
  metadata Json? // Additional context
  tags     String[] @default([]) // Categorization tags

  // Request information
  ipAddress String?
  userAgent String?
  requestId String? // For tracing requests
  sessionId String?

  // Result
  success      Boolean @default(true)
  errorMessage String?

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  // Indexes
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@index([success])
  @@map("audit_logs")
}


// ===================================
// FILE MANAGEMENT MODELS
// ===================================

model File {
  // Primary Key
  id String @id @default(uuid())

  // File identification
  originalName String
  filename     String  @unique
  path         String
  url          String?

  // File properties
  mimeType  String
  size      Int
  extension String?

  // Metadata
  metadata    Json?
  description String?
  tags        String[] @default([])

  // Ownership and access
  uploadedBy String?
  isPublic   Boolean @default(false)

  // Storage information
  storageType String  @default("s3") // local, s3, cloudinary, etc.
  bucketName  String?

  // Processing status
  isProcessed      Boolean @default(true)
  processingStatus String? // pending, processing, completed, failed

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Indexes
  @@index([filename])
  @@index([uploadedBy])
  @@index([mimeType])
  @@index([isPublic])
  @@index([storageType])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("files")
}

// ===================================
// SUPPORT TICKET MODELS
// ===================================

// Support tickets for admin panel
model SupportTicket {
  // Primary Key
  id String @id @default(uuid())

  // User who created the ticket
  userId String
  user   User   @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)

  // Ticket details
  subject     String
  description String  @db.Text
  category    String? // e.g., "Billing", "OCR Issue", "Account"

  // Status & priority
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  // Assignment (for admin)
  assignedToId String?
  assignedTo   User?     @relation("AssignedTickets", fields: [assignedToId], references: [id])
  assignedAt   DateTime?

  // Resolution
  resolvedAt DateTime?
  resolution String?   @db.Text

  // Attachments (store file IDs or URLs)
  attachments Json? // Array of file URLs/IDs

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Indexes
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("support_tickets")
}

// ===================================
// ACCOUNT DELETION FEEDBACK MODEL
// ===================================

// Track account deletion reasons for analytics
model AccountDeletion {
  // Primary Key
  id String @id @default(uuid())

  // User information (before deletion)
  userId   String
  email    String
  fullName String?
  userRole String?

  // Deletion reasons
  reasons String[] // Array of deletion reasons

  // Additional feedback
  feedback String? @db.Text

  // Metadata
  deletedBy String // "user" or admin ID
  userAgent String?
  ipAddress String?

  // Audit fields
  createdAt DateTime @default(now())

  // Indexes
  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("account_deletions")
}

// ===================================
// CAR RENTAL MODELS
// ===================================

// Vendor profile — linked to User with role = VENDOR
model VendorProfile {
  id String @id @default(uuid())

  // Link to User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business information
  businessName    String
  tradeLicense    String?  @unique
  businessAddress String?
  city            String?
  state           String?
  country         String?

  // Banking details (for payouts)
  bankName      String?
  accountNumber String?
  iban          String?
  swiftCode     String?

  // Verification
  status          VendorStatus @default(PENDING)
  isVerified      Boolean      @default(false)
  verifiedAt      DateTime?
  verifiedBy      String?      // Admin userId who verified
  rejectionReason String?

  // Stats (denormalized for quick reads)
  rating        Float?   // Average rating from reviews
  totalEarnings Decimal? @db.Decimal(10, 2)
  totalBookings Int      @default(0)

  // Flexible metadata
  metadata Json?

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Relations
  vehicles       Vehicle[]
  unlistRequests UnlistRequest[]

  // Indexes
  @@index([userId])
  @@index([status])
  @@index([isVerified])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("vendor_profiles")
}

// Main vehicle listing
model Vehicle {
  id String @id @default(uuid())

  // Ownership
  vendorId String
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Basic information
  brand        String
  model        String
  year         Int
  color        String?
  licensePlate String?   @unique
  vin          String?   @unique // Vehicle Identification Number
  description  String?   @db.Text

  // Specifications
  category     VehicleCategory
  fuelType     FuelType
  transmission TransmissionType
  seats        Int
  mileage      Int?     // Current odometer reading (km)

  // Pricing
  dailyRate       Decimal @db.Decimal(10, 2)
  monthlyRate     Decimal? @db.Decimal(10, 2)
  minRentalDays   Int     @default(1)
  securityDeposit Decimal? @db.Decimal(10, 2)

  // Location
  pickupLocation String?
  city           String?
  state          String?
  country        String?
  latitude       Float?
  longitude      Float?

  // Features and tags
  features String[] @default([]) // e.g. ["GPS", "Bluetooth", "Sunroof"]
  tags     String[] @default([]) // e.g. ["luxury", "family", "sports"]

  // Insurance
  insuranceType   String?   // "own" or "platform"
  insuranceExpiry DateTime?

  // Admin review
  status          VehicleStatus @default(DRAFT)
  rejectionReason String?
  reviewedBy      String?   // Admin userId
  reviewedAt      DateTime?
  publishedAt     DateTime? // When it went live

  // Stats (denormalized)
  rating        Float?
  totalBookings Int    @default(0)

  // Flexible metadata
  metadata Json?

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Relations
  images         VehicleImage[]
  documents      VehicleDocument[]
  bookings       Booking[]
  reviews        Review[]
  unlistRequests UnlistRequest[]
  subscriptions  UserSubscription[]

  // Indexes
  @@index([vendorId])
  @@index([status])
  @@index([category])
  @@index([fuelType])
  @@index([city])
  @@index([dailyRate])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([isDeleted])
  @@map("vehicles")
}

// Vehicle photos (multiple per vehicle)
model VehicleImage {
  id String @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url       String
  type      String?  // "front" | "rear" | "interior" | "side" | "other"
  isPrimary Boolean  @default(false)
  order     Int      @default(0)

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Indexes
  @@index([vehicleId])
  @@index([isPrimary])
  @@index([isDeleted])
  @@map("vehicle_images")
}

// Vehicle documents (registration, insurance, etc.)
model VehicleDocument {
  id String @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type     DocumentType
  url      String
  filename String?
  fileSize Int?

  expiresAt  DateTime?
  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  verifiedBy String?

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Indexes
  @@index([vehicleId])
  @@index([type])
  @@index([isDeleted])
  @@map("vehicle_documents")
}

// Vendor requests to unlist a vehicle
model UnlistRequest {
  id String @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   VendorProfile @relation(fields: [vendorId], references: [id])

  reason        String    @db.Text
  requestedDate DateTime  // Vendor-requested removal date (min 7 days from submission)

  status     UnlistRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  adminNote  String?

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([vehicleId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@map("unlist_requests")
}

// Booking created when customer rents a vehicle
model Booking {
  id            String @id @default(uuid())
  bookingNumber String @unique // Auto-generated: BKG-YYYYMMDD-XXXX

  // Parties involved
  customerId String
  customer   User   @relation("CustomerBookings", fields: [customerId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  vendorId String // Denormalized for quick queries (vendor of the vehicle at time of booking)

  // Booking type
  type BookingType @default(DAILY)

  // Dates
  pickupDate       DateTime
  returnDate       DateTime
  actualReturnDate DateTime? // Filled when vehicle is actually returned

  // Locations
  pickupLocation String
  returnLocation String

  // Pricing snapshot (locked at time of booking)
  dailyRate       Decimal @db.Decimal(10, 2)
  totalDays       Int
  subtotal        Decimal @db.Decimal(10, 2)
  tax             Decimal @db.Decimal(10, 2) @default(0)
  discount        Decimal @db.Decimal(10, 2) @default(0)
  totalAmount     Decimal @db.Decimal(10, 2)
  securityDeposit Decimal @db.Decimal(10, 2) @default(0)
  currency        String  @default("USD")

  // Status
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // Customer snapshot (in case user data changes)
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  customerAddress Json?   // { address, city, state, postalCode, landmark }

  // Additional info
  specialRequests    String?   @db.Text
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?   // userId who cancelled

  // Flexible metadata
  metadata Json?

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relations
  payment Payment?
  review  Review?

  // Indexes
  @@index([customerId])
  @@index([vehicleId])
  @@index([vendorId])
  @@index([status])
  @@index([paymentStatus])
  @@index([pickupDate])
  @@index([returnDate])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("bookings")
}

// Stripe payment record linked to a booking
model Payment {
  id        String @id @default(uuid())
  bookingId String @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Stripe identifiers
  stripePaymentIntentId String?  @unique
  stripeChargeId        String?
  stripeRefundId        String?
  stripeCustomerId      String?

  // Payment details
  amount        Decimal @db.Decimal(10, 2)
  currency      String  @default("USD")
  status        PaymentStatus
  method        String? // "card", "bank_transfer"

  // Card info (display only — Stripe stores actual data)
  last4     String?
  cardBrand String? // "visa", "mastercard", etc.

  // Timestamps
  paidAt       DateTime?
  refundedAt   DateTime?
  refundAmount Decimal?  @db.Decimal(10, 2)
  refundReason String?

  // Flexible metadata
  metadata Json?

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([bookingId])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// Customer review after completed booking
model Review {
  id        String  @id @default(uuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id])

  // Rating (1–5)
  rating  Int
  comment String? @db.Text

  // Moderation
  isVisible  Boolean   @default(true)
  hiddenAt   DateTime?
  hiddenBy   String?
  hideReason String?

  // Vendor response
  vendorReply String?   @db.Text
  repliedAt   DateTime?

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Indexes
  @@index([vehicleId])
  @@index([reviewerId])
  @@index([bookingId])
  @@index([rating])
  @@index([isVisible])
  @@index([isDeleted])
  @@map("reviews")
}

// Subscription plan definitions (managed by Admin)
model SubscriptionPlan {
  id          String @id @default(uuid())

  name        String
  description String? @db.Text
  price       Decimal @db.Decimal(10, 2)
  interval    SubscriptionInterval

  // What's included
  features   String[] @default([])
  maxMileage Int?     // km included per period
  isActive   Boolean  @default(true)

  // Stripe Price ID for recurring billing
  stripePriceId String? @unique

  // Flexible metadata
  metadata Json?

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relations
  subscriptions UserSubscription[]

  // Indexes
  @@index([isActive])
  @@index([interval])
  @@index([isDeleted])
  @@map("subscription_plans")
}

// Customer's active subscription to a plan (optionally tied to a specific vehicle)
model UserSubscription {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(PENDING)

  // Billing period
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  // Cancellation
  cancelledAt  DateTime?
  cancelReason String?

  // Stripe
  stripeSubscriptionId String? @unique
  stripeCustomerId     String?

  // Flexible metadata
  metadata Json?

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([userId])
  @@index([vehicleId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
  @@map("user_subscriptions")
}

// In-app notifications for users and vendors
model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Content
  title   String
  message String @db.Text

  // Classification
  type     NotificationType   // EMAIL | SMS | PUSH | IN_APP | SYSTEM_ALERT
  category String?            // "booking" | "vehicle" | "payment" | "system" | "admin"

  // Related resource (deep link support)
  resourceType String? // "booking" | "vehicle" | "ticket" | etc.
  resourceId   String?
  actionUrl    String? // Frontend route to navigate to

  // Status
  status NotificationStatus @default(UNREAD)
  readAt DateTime?

  // Flexible metadata
  metadata Json?

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Indexes
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("notifications")
}

