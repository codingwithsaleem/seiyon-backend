# =================================
# APPLICATION CONFIGURATION
# =================================
NODE_ENV=development
APP_NAME="seiyon Contract Management Platform"
APP_VERSION=1.0.0
APP_PORT=6001
APP_HOST=localhost
BASE_URL=http://localhost:6001/api/v1

# =================================
# DATABASE CONFIGURATION
# =================================
DATABASE_URL="postgresql://postgres:root@localhost:5432/mytab_dev"
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30000
# SSL Configuration (required for RDS/Production databases)
# Set to 'true' for production/RDS, 'false' for local development
DATABASE_SSL=false
# Set to 'false' for self-signed certificates (common in development)
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# =================================
# REDIS CONFIGURATION
# =================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=5000

# =================================
# JWT CONFIGURATION
# =================================
ACCESS_TOKEN_SECRET="L1O0gJh2SfN!v8WT^MZ9dXbQZ@K#rE3m$YuP4AZ6&CNxEjTp7b"
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET="cU7vGp$9BnKx#QL^z!F0JEoYXuT@hW63sVm@A1NRw*dCYZp4qM"
JWT_REFRESH_EXPIRES_IN=30d


# =================================
# BCRYPT CONFIGURATION
# =================================
BCRYPT_ROUNDS=12

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# EMAIL CONFIGURATION
# =================================
# SendGrid (Primary Email Service)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@seiyon.com
SENDGRID_FROM_NAME="MyTab App"

# SMTP (Alternative Email Service - Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Note: For Gmail, enable 2FA and create an App Password
# https://support.google.com/accounts/answer/185833

# =================================
# SMS CONFIGURATION (Twilio)
# =================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =================================
# AWS CONFIGURATION
# =================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name

# =================================
# CORS CONFIGURATION
# =================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://www.mytabze.com/,https://tlztdz38-6001.inc1.devtunnels.ms/
CORS_CREDENTIALS=true

# =================================
# LOGGING CONFIGURATION
# =================================
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

# =================================
# MONITORING & OBSERVABILITY
# =================================
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
DATADOG_API_KEY=your-datadog-api-key

# =================================
# SECURITY CONFIGURATION
# =================================
ENCRYPTION_KEY=your-32-character-encryption-key-here
SESSION_SECRET=your-session-secret-key-change-this
COOKIE_SECRET=your-cookie-secret-key-change-this

# =================================
# FEATURE FLAGS
# =================================
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_RATE_LIMITING=true
ENABLE_HELMET=true
ENABLE_COMPRESSION=true

# =================================
# SSO CONFIGURATION
# =================================
# Google OAuth (optional - for custom SSO)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In (required for custom Apple SSO)
APPLE_CLIENT_ID=com.seiyon.service
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./apple-key.p8

# Firebase Admin SDK (for Firebase SSO - recommended)
# Option 1: Use service account file (recommended for production)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Use environment variables (alternative)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# =================================
# EXTERNAL SERVICES
# =================================
SLACK_WEBHOOK_URL=your-slack-webhook-url
DISCORD_WEBHOOK_URL=your-discord-webhook-url

# =================================
# FILE UPLOAD CONFIGURATION
# =================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_PATH=uploads/

# =================================
# GOOGLE CLOUD VISION API (OCR)
# =================================
# Path to Google Cloud service account JSON credentials file
# Get from: https://console.cloud.google.com/apis/credentials
# Create service account -> Download JSON key -> Set path here
GOOGLE_APPLICATION_CREDENTIALS=./google-cloud-credentials.json
# Alternative: Set GOOGLE_CLOUD_PROJECT_ID and use ADC (Application Default Credentials)
# GOOGLE_CLOUD_PROJECT_ID=your-project-id

# =================================
# IN-APP PURCHASE CONFIGURATION
# =================================
# Apple App Store Configuration
APPLE_SHARED_SECRET=your-apple-shared-secret-from-app-store-connect
# Get from: App Store Connect -> My Apps -> App -> App Information -> App-Specific Shared Secret

# Google Play Store Configuration
GOOGLE_PACKAGE_NAME=com.seiyon.app
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Google Service Account Private Key\n-----END PRIVATE KEY-----\n"
# Get from: Google Play Console -> API access -> Create service account -> Download JSON

# Product IDs (must match App Store Connect and Google Play Console)
# Apple: com.seiyon.premium.monthly, com.seiyon.premium.annual
# Google: mytab_premium_monthly, mytab_premium_annual
