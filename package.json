{
  "name": "seiyon-mobile-app-backend",
  "version": "1.0.0",
  "description": "Mobile App Backend with TypeScript, Prisma, and modern best practices",
  "main": "dist/src/server.js",
  "author": "Saleem Raza (sr.saleem74@gmail.com)",
  "keywords": [
    "nodejs",
    "typescript",
    "prisma",
    "express",
    "boilerplate"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.ts",
    "dev:debug": "nodemon --inspect src/server.ts",
    "build": "npx prisma generate && rimraf dist && tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/src/server.js",
    "start:prod": "NODE_ENV=production node dist/src/server.js",
    "preview": "pnpm build && pnpm start",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "docker:build": "docker build -t advanced-nodejs-boilerplate .",
    "docker:run": "docker run -p 6001:6001 --env-file .env advanced-nodejs-boilerplate",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "deploy:setup": "chmod +x scripts/*.sh",
    "deploy:migrate": "pnpm db:migrate:deploy",
    "deploy:build": "pnpm build",
    "deploy:production": "pnpm deploy:build && pnpm deploy:migrate",
    "swagger": "ts-node src/config/swagger.ts",
    "swagger:generate": "swagger-jsdoc -d src/config/swagger.ts -o swagger.json src/**/*.ts",
    "security:audit": "pnpm audit --audit-level moderate",
    "security:check": "snyk test",
    "security:monitor": "snyk monitor",
    "health": "curl -f http://localhost:6001/health || exit 1",
    "validate": "pnpm type-check && pnpm lint:check && pnpm format:check && pnpm test",
    "precommit": "lint-staged",
    "prepare": "husky install",
    "clean": "rimraf dist coverage .nyc_output"
  },
  "_moduleAliases": {
    "@packages": "dist/packages",
    "@src": "dist/src",
    "@config": "dist/src/config",
    "@controllers": "dist/src/controllers",
    "@middleware": "dist/src/middleware",
    "@routes": "dist/src/routes",
    "@services": "dist/src/services",
    "@utils": "dist/src/utils",
    "@types": "dist/src/types",
    "@models": "dist/src/models"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "pnpm test"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/server.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.835.0",
    "@aws-sdk/client-s3": "^3.974.0",
    "@aws-sdk/credential-providers": "^3.835.0",
    "@aws-sdk/s3-request-presigner": "^3.974.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@google-cloud/vision": "^5.3.4",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sendgrid/mail": "^8.1.5",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-schedule": "^2.1.8",
    "@types/pg": "^8.16.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.13.3",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "dotenv-flow": "^4.1.0",
    "express": "^5.1.0",
    "express-jsdoc-swagger": "^1.8.0",
    "express-rate-limit": "^8.0.1",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.1",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-schedule": "^2.1.1",
    "nodemailer": "^7.0.12",
    "openai": "^6.17.0",
    "pg": "^8.17.1",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "twilio": "^5.11.2",
    "winston": "^3.17.0",
    "zod": "^3.25.75"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.3",
    "@types/nodemailer": "^7.0.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "aws-sdk-client-mock": "^4.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-security": "^1.7.1",
    "globals": "^16.3.0",
    "husky": "^8.0.3",
    "lint-staged": "^16.1.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.0",
    "prisma": "^7.2.0",
    "prisma-docs-generator": "^0.8.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0"
  },
  "packageManager": "pnpm@10.13.1"
}
